#!/usr/bin/env bash
# cc-retry-watchdog -- control script
set -euo pipefail

# Resolve our own directory, following the symlink that install.sh drops in PATH.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
CODE_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# Runtime state lives outside the checkout so `git pull` never fights with logs.
BASE="${CC_AUTORESUME_HOME:-$HOME/.claude/cc-autoresume}"
mkdir -p "$BASE"

PY="$(command -v python3 || echo /usr/bin/python3)"
SETTINGS="$HOME/.claude/settings.json"
LOG="$BASE/watchdog.log"
CFG="$BASE/config.json"
PAUSE="$BASE/PAUSED"
PIDFILE="$BASE/watchdog.pid"
AGENT_LABEL="com.cc-retry-watchdog.daemon"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

usage() {
  cat <<'EOF'
Usage: ccwatch <command>

  check       Scan every terminal and report; never injects. Safe anytime.
  once        Scan once and inject if a session qualifies.
  start       Start the watchdog in the background.
  autostart   Same, but silent and a no-op if already running. Put this in your
              shell rc so the first terminal you open after login starts it:
                  [[ -o interactive ]] && command -v ccwatch >/dev/null && ccwatch autostart
  stop        Stop it.
  restart     Stop, then start.
  status      Daemon state and current config.
  log [n]     Tail the log (default 40 lines).
  hook        Is the StopFailure hook registered? Any pending tickets?
  keepalive on|off
              Have launchd start the watchdog at login and restart it if it
              dies. Refuses to install until it has *proved* a launchd-started
              process can drive your terminals -- see the macOS note below.
  pause       Stop injecting; keep the daemon running.
  resume      Undo pause.
  dry on|off  Toggle dry-run (log what it would do, inject nothing).
  config      Open the config file in $EDITOR.

macOS note: run `start` from a real Terminal/iTerm window. Driving a terminal
needs AppleScript automation rights, which are granted to the *responsible*
app; a process spawned by launchd may have no such identity, in which case its
AppleEvents are refused or hang. tmux-only setups are unaffected.

That is why `keepalive on` runs the real AppleEvent first and installs nothing
unless it comes back. The failure it is guarding against is not "the watchdog
does not start" -- it is far worse: a watchdog that holds the pidfile, logs
cheerful heartbeats, sees zero sessions and rescues nothing. Whether launchd
has the right depends on the machine, so this is measured, never assumed.
EOF
}

cmd="${1:-}"
case "$cmd" in
  check)   exec "$PY" "$CODE_DIR/watchdog.py" --check ;;
  once)    exec "$PY" "$CODE_DIR/watchdog.py" --once ;;

  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "Already running (pid $(cat "$PIDFILE")). Use: ccwatch restart"; exit 0
    fi
    nohup "$PY" "$CODE_DIR/watchdog.py" >> "$BASE/daemon.out.log" 2>&1 &
    echo $! > "$PIDFILE"
    disown 2>/dev/null || true
    sleep 1
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "Started (pid $(cat "$PIDFILE")). Logs: ccwatch log"
    else
      echo "Failed to start; see $BASE/daemon.out.log"; exit 1
    fi
    ;;

  autostart)
    # For a shell rc file: silent, instant, safe to run on every new terminal.
    #
    # The tty check is the point of this command. On macOS the watchdog can only
    # drive terminals if it inherits the automation rights of the app that
    # spawned it, so it has to come from a real terminal window. A shell with no
    # controlling tty is something else -- a sandboxed tool shell, a CI step, a
    # hook -- and a watchdog started there would sit timing out on every
    # AppleEvent while holding the pidfile a healthy one needs.
    [ -t 0 ] || [ -t 1 ] || exit 0
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    pgrep -f "$CODE_DIR/watchdog.py" >/dev/null 2>&1 && exit 0
    nohup "$PY" "$CODE_DIR/watchdog.py" >> "$BASE/daemon.out.log" 2>&1 &
    echo $! > "$PIDFILE"
    disown 2>/dev/null || true
    exit 0
    ;;

  stop)
    if [ -f "$PIDFILE" ]; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; fi
    pkill -f "$CODE_DIR/watchdog.py" 2>/dev/null || true
    echo "Stopped."
    ;;

  restart) "$0" stop; sleep 1; "$0" start ;;

  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "Daemon:    running (pid $(cat "$PIDFILE"))"
    elif pgrep -f "$CODE_DIR/watchdog.py" >/dev/null 2>&1; then
      echo "Daemon:    running (pid $(pgrep -f "$CODE_DIR/watchdog.py" | head -1))"
    else
      echo "Daemon:    not running"
    fi
    [ -f "$PAUSE" ] && echo "Injection: PAUSED" || echo "Injection: enabled"
    echo "Code:      $CODE_DIR"
    echo "State:     $BASE"
    echo "--- config ---"; cat "$CFG" 2>/dev/null || echo "(created on first run)"
    ;;

  hook)
    "$PY" - "$SETTINGS" "$BASE" "$CODE_DIR" <<'PYEOF'
import json, os, sys, time
settings, base, code = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cfg = json.load(open(settings, encoding="utf-8"))
except Exception as e:
    cfg = {}
    print("Could not read settings.json: %s" % e)
found = [h.get("command") for e in cfg.get("hooks", {}).get("StopFailure", [])
         for h in (e.get("hooks") or []) if "hook_stopfailure.py" in (h.get("command") or "")]
print("StopFailure hook: %s" % ("registered" if found else "NOT registered"))
for c in found:
    print("  %s" % c)
if not found:
    print("  install it with:  %s/install.sh --hook" % code)
d = os.path.join(base, "triggers")
files = sorted(f for f in os.listdir(d)) if os.path.isdir(d) else []
files = [f for f in files if f.endswith(".json")]
print("Pending tickets: %d" % len(files))
for f in files:
    try:
        r = json.load(open(os.path.join(d, f), encoding="utf-8"))
        print("  %s  %.0fs ago  %s" % (r.get("tty"),
                                       time.time() - float(r.get("ts") or 0),
                                       (r.get("error") or "")[:50]))
    except Exception:
        print("  %s (unreadable)" % f)
PYEOF
    ;;

  log)     tail -n "${2:-40}" "$LOG" 2>/dev/null || echo "(no log yet)" ;;
  # Run in the foreground so launchd's KeepAlive can supervise us.
  agent-run)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    pgrep -f "$CODE_DIR/watchdog.py" >/dev/null 2>&1 && exit 0
    if ! "$0" preflight >/dev/null 2>&1; then
      echo "[$(date '+%F %T')] launchd agent stood down: cannot drive terminals from here" >> "$BASE/daemon.out.log"
      exit 0        # exit 0, not non-zero: do not let launchd spin on this
    fi
    echo $$ > "$PIDFILE"
    exec "$PY" "$CODE_DIR/watchdog.py"
    ;;

  # Can a process in *this* context actually drive the terminals? Asks the app
  # the sweep will ask, and only one that is already running -- probing a
  # stopped Terminal would launch it, which is not ours to do.
  preflight)
    [ "$(uname)" = "Darwin" ] || exit 0        # tmux path needs no automation rights
    checked=0
    for app in Terminal iTerm2; do
      # Not pgrep -x: for a GUI app that matches the full executable path, not
      # the name, so it never fires. Compare basenames instead -- and no
      # AppleScript here, since a probe that needs its own permission to run
      # cannot tell "not running" from "not permitted".
      ps -Ao comm= | sed 's|.*/||' | grep -qx "$app" || continue
      checked=1
      osascript -e "tell application \"$app\" to return (count of windows)" >/dev/null 2>&1 || {
        echo "cannot drive $app from here (AppleEvent refused)"; exit 1; }
    done
    [ "$checked" = 1 ] || echo "no terminal app running; nothing to prove against"
    exit 0
    ;;

  keepalive)
    case "${2:-}" in
      on)
        if ! "$0" preflight; then
          echo "Refusing to install: a launchd-started process cannot drive your terminals here."
          echo "It would hold the pidfile and rescue nothing. Use 'ccwatch autostart' in your shell rc instead."
          exit 1
        fi
        mkdir -p "$HOME/Library/LaunchAgents"
        cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$AGENT_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$CODE_DIR/ccwatch</string>
        <string>agent-run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>$BASE/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>$BASE/daemon.out.log</string>
</dict>
</plist>
PLIST
        launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
        "$0" stop >/dev/null 2>&1 || true
        launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
        echo "KeepAlive on. launchd starts it at login and restarts it if it dies."
        echo "  plist: $AGENT_PLIST"
        ;;
      off)
        launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
        rm -f "$AGENT_PLIST"
        echo "KeepAlive off. The daemon is no longer supervised; 'ccwatch start' still works."
        ;;
      *)
        if [ -f "$AGENT_PLIST" ]; then echo "KeepAlive: on  ($AGENT_PLIST)"; else echo "KeepAlive: off"; fi
        echo "Usage: ccwatch keepalive on|off"
        ;;
    esac
    ;;

  pause)   touch "$PAUSE"; echo "Injection paused." ;;
  resume)  rm -f "$PAUSE"; echo "Injection resumed." ;;

  dry)
    v="${2:-}"
    [ "$v" = "on" ] || [ "$v" = "off" ] || { echo "Usage: ccwatch dry on|off"; exit 1; }
    [ "$v" = "on" ] && b=true || b=false
    "$PY" - "$CFG" "$b" <<'PYEOF'
import json, sys
p, b = sys.argv[1], sys.argv[2] == "true"
try:
    c = json.load(open(p, encoding="utf-8"))
except Exception:
    c = {}
c["dry_run"] = b
json.dump(c, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print("dry_run =", b)
PYEOF
    ;;

  config)  "${EDITOR:-open}" "$CFG" ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
